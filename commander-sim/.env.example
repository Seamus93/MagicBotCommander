DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Controls how much EpisodeStep data is stored in Postgres.
# - off:   store no per-step rows (smallest DB)
# - digest store a compact state digest (default)
# - full:  store full state/actions (can grow very fast)
EPISODE_STEP_STORAGE=digest

# When DATABASE_URL is configured, policy records and episode replay are best kept in DB.
# Keep local artifacts only if you explicitly want snapshots on disk.
STORE_POLICY_FILE=false
STORE_DATASET_FILE=false

# Services (ports)
SIM_SERVER_PORT=5100
AI_DECISION_PORT=5200

# Frontend (Vite only exposes vars starting with VITE_)
VITE_AI_DECISION_URL=http://localhost:5200

# Live policy loading:
# source order is DATABASE_URL policy records, then POLICY_PATH/data/policy.json.
# Empty live policy is blocked unless this is explicitly true.
POLICY_PATH=./data/policy.json
ALLOW_EMPTY_POLICY_FALLBACK=false

# Decision tree confidence:
# confidence = visits / (visits + DECISION_TREE_CONFIDENCE_K).
# DECISION_TREE_CONFIDENCE remains the confidence threshold for backward compatibility.
DECISION_TREE_CONFIDENCE=0.8
DECISION_TREE_MIN_VISITS=5
DECISION_TREE_CONFIDENCE_K=50

# Training matchup mode: mirror | round-robin | random.
# If unset and multiple decks are available, training defaults to round-robin.
# MATCHUP_MODE=mirror

# Rules coverage warning threshold before training. Currently warns, does not block.
MIN_RULES_COVERAGE_FOR_TRAINING=0.90
