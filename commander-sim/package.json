{
  "name": "commander-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/ui-player/vite.config.ts",
    "dev:spelltable": "vite --config apps/ui-player/vite.spelltable.config.ts",
    "build": "tsc -b && vite build --config apps/ui-player/vite.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config apps/ui-player/vite.config.ts",
    "api": "node apps/api/server.cjs",
    "ai:server": "tsx --tsconfig tsconfig.base.json apps/ai-service/ai-server.ts",
    "sim:server": "tsx --tsconfig tsconfig.base.json apps/sim-service/sim-server.ts",
    "all": "concurrently \"npm run dev\" \"npm run dev:spelltable\" \"npm run api\" \"npm run ai:server\" \"npm run sim:server\" \"npm run game:server\"",
    "game:server": "tsx --tsconfig tsconfig.base.json apps/game-server/game-server.ts",
    "train": "tsx --tsconfig tsconfig.base.json packages/sim/src/run-batch.ts",
    "eval:ab": "tsx --tsconfig tsconfig.base.json packages/sim/src/evaluate-ab.ts",
    "train:reset": "tsx packages/sim/src/resetTrainingData.ts",
    "inspect:episodes": "tsx --tsconfig tsconfig.base.json packages/sim/src/inspectEpisodes.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2",
    "prisma": "^5.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.3",
    "uuid": "^11.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
